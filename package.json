{
  "name": "tcg-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Transparent desktop companion game — convention floor & shop",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/generate-catalog.mjs",
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "generate:sfx": "node scripts/build-sfx.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "concurrently": "^9.1.2",
    "electron": "^36.3.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
